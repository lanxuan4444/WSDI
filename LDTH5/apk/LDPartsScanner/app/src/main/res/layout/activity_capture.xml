<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/captureHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center"
        android:padding="10dp"
        android:text="拍摄类型"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- [v1.15] CPU 取景框形状切换：12代+/Ultra 长方形顶盖 ↔ 旧款正方形顶盖 -->
    <LinearLayout
        android:id="@+id/shapeSwitchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="46dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShapeRect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#33BB77"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="▭ 12代+/Ultra"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnShapeSquare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="#556655"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="▢ 旧款"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- [v1.15] CPU 取景框：用户把 CPU 对齐框内（位置/大小标准化 → 边缘编号识别率提升） -->
    <com.ldtools.parts.GuideOverlayView
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnTorch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀ 手电" />

        <Button
            android:id="@+id/btnShutter"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:backgroundTint="#FFFFFF"
            android:text="拍"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消" />
    </LinearLayout>
</FrameLayout>
