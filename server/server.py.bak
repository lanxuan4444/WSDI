    "cardreader": ["card reader", "sd host", "memory card"],
    "printer": ["printer", "printing"],
    "monitor": ["monitor", "generic pnp"],
    "modem": ["modem"],
    "ports": ["serial", "com port", "parallel", "communications port"],
}

# 硬件ID到驱动包名的精确映射
# VEN_xxxx -> 对应的驱动包名关键词
HWID_VENDOR_MAP = {
    "ven_8086": {"video": "intel", "lan": "intel", "wlan": "intel", "chipset": "intel", "sounds": "intel", "sound": "intel", "massstorage": "intel"},
    "ven_1002": {"video": "amd", "videos": "amd", "sound": "amd", "sounds": "amd"},
    "ven_10de": {"video": "nvidia", "sound": "nvidia", "sounds": "nvidia"},
    "ven_10ec": {"lan": "realtek", "sound": "realtek", "sounds": "realtek", "wlan": "realtek"},
    "ven_14e4": {"lan": "broadcom", "wlan": "broadcom"},
    "ven_168c": {"wlan": "qualcomm"},
    "ven_8086": {"wlan": "intel"},
    "ven_17cb": {"wlan": "qualcomm"},
    "ven_11ab": {"lan": "marvell"},
    "ven_1969": {"lan": "qualcomm"},
    "ven_1b4b": {"massstorage": "marvell"},
