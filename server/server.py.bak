    "video": ["display controller", "vga compatible", "graphics adapter", "intel hd graphics", "intel uhd graphics", "intel iris", "nvidia geforce", "nvidia quadro", "radeon", "video controller"],
    "videos": ["display controller", "vga compatible", "graphics adapter", "radeon", "amd radeon", "video controller"],
