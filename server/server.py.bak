def load_driver_index():
    """加载预构建的驱动索引 JSON 文件"""
    global _driver_index, _driver_index_pkgs
    if _driver_index is not None:
        return _driver_index, _driver_index_pkgs
    
    if os.path.exists(INDEX_FILE):
        try:
            with open(INDEX_FILE, 'r', encoding='utf-8') as f:
                _driver_index = json.load(f)
            _driver_index_pkgs = _driver_index.pop('_packages_indexed', {})
            print(f"[INFO] 加载驱动索引: {len(_driver_index)} 个 HWID, {len(_driver_index_pkgs)} 个包")
        except Exception as e:
            print(f"[WARN] 索引加载失败: {e}, 将使用 7z 实时扫描")
            _driver_index = {}
            _driver_index_pkgs = {}
    else:
        print("[INFO] 索引文件不存在，使用 7z 实时扫描 (运行 build_index.py 可构建索引)")
        _driver_index = {}
        _driver_index_pkgs = {}
    
    return _driver_index, _driver_index_pkgs


def fast_search_by_index(hwids, selected_drivers=None):
    """
    使用 JSON 索引快速查找 HWID 匹配的驱动包
    毫秒级响应，无需调用 7z
    """
    index, pkgs_info = load_driver_index()
    if not index:
        return None  # 索引未就绪
    
    matched_pkgs = {}
    
    for hwid in hwids:
        hwid_upper = hwid.strip().upper()
        
        # 精确匹配
        if hwid_upper in index:
            for pkg in index[hwid_upper]:
                if selected_drivers and pkg not in selected_drivers:
                    continue
                if pkg not in matched_pkgs:
                    matched_pkgs[pkg] = set()
                matched_pkgs[pkg].add(hwid_upper)
            continue
        
        # 去掉 SUBSYS 匹配
        if '&SUBSYS' in hwid_upper:
            base = hwid_upper.split('&SUBSYS')[0]
            if base in index:
                for pkg in index[base]:
                    if selected_drivers and pkg not in selected_drivers:
                        continue
                    if pkg not in matched_pkgs:
                        matched_pkgs[pkg] = set()
                    matched_pkgs[pkg].add(hwid_upper)
                continue
        
        # 去掉 REV 匹配
        if '&REV' in hwid_upper:
            base = hwid_upper.split('&REV')[0]
            if base in index:
                for pkg in index[base]:
                    if selected_drivers and pkg not in selected_drivers:
                        continue
                    if pkg not in matched_pkgs:
                        matched_pkgs[pkg] = set()
                    matched_pkgs[pkg].add(hwid_upper)
    
    # 转换为结果格式
    results = []
    for pkg_name, matched_hwids in matched_pkgs.items():
        pkg_path = os.path.join(DRIVERS_DIR, pkg_name)
        size_mb = round(os.path.getsize(pkg_path) / 1024 / 1024, 1) if os.path.exists(pkg_path) else 0
        results.append({
            "file": pkg_name,
            "matched_hwids": list(matched_hwids),
            "matched_count": len(matched_hwids),
            "size_mb": size_mb,
            "download_url": f"/api/download_pkg/{urllib.parse.quote(pkg_name)}"
        })
    
    return results


def get_driver_list():
    """获取所有驱动包列表"""
    drivers = []
    if os.path.isdir(DRIVERS_DIR):
        for f in os.listdir(DRIVERS_DIR):
            if f.endswith(".7z"):
                path = os.path.join(DRIVERS_DIR, f)
                drivers.append({
                    "file": f,
                    "name": f[:-3],
                    "size_mb": round(os.path.getsize(path) / 1024 / 1024, 1)
                })
    return drivers

def match_drivers_for_device(device_desc, device_hwid):
    """根据设备描述和硬件ID匹配驱动包分类和厂商"""
    desc = device_desc.lower()
    hwid = device_hwid.lower()
    matched = set()
    vendor_hints = {}  # {category: vendor_name}

    # 1. 先从硬件ID中提取 vendor/device
    ven = ""
    dev = ""
    subsys = ""
    if "ven_" in hwid:
        try:
            ven = hwid.split("ven_")[1][:4]
        except: pass
    if "dev_" in hwid:
        try:
            dev = hwid.split("dev_")[1][:4]
        except: pass
    if "subsys_" in hwid:
        try:
            subsys = hwid.split("subsys_")[1][:8]
        except: pass

    # 2. 根据描述匹配分类
    for cat, keywords in CATEGORY_KEYWORDS.items():
        for kw in keywords:
            if kw in desc or kw in hwid:
                matched.add(cat)
                break

    # 3. 根据硬件ID精确匹配
    if "ven_8086" in hwid:
        if any(k in desc for k in ["display", "vga", "graphics", "hd graphics", "uhd graphics", "iris"]):
            matched.add("video")
            vendor_hints["video"] = "intel"
        if any(k in desc for k in ["audio", "sound", "multimedia", "hdaudio"]):
            matched.add("sound")
            vendor_hints["sound"] = "intel"
        if any(k in desc for k in ["sata", "ahci", "raid", "nvme", "storage"]):
            matched.add("massstorage")
            vendor_hints["massstorage"] = "intel"
        if any(k in desc for k in ["ethernet", "network", "lan", "gigabit"]):
            matched.add("lan")
            vendor_hints["lan"] = "intel"
        if any(k in desc for k in ["wireless", "wifi", "wlan", "wi-fi"]):
            matched.add("wlan")
            vendor_hints["wlan"] = "intel"
        if any(k in desc for k in ["usb", "xhci"]):
            matched.add("xusb")
            vendor_hints["xusb"] = "intel"
        # Intel 芯片组相关
        if any(k in desc for k in ["pci bridge", "smbus", "lpc", "isa", "management engine", "chipset"]):
            matched.add("chipset")
            vendor_hints["chipset"] = "intel"

    elif "ven_1002" in hwid:
        if any(k in desc for k in ["display", "vga", "graphics", "radeon"]):
            matched.add("videos")
            vendor_hints["videos"] = "amd"
        if any(k in desc for k in ["audio", "sound", "hdaudio"]):
            matched.add("sounds")
            vendor_hints["sounds"] = "amd"

    elif "ven_10de" in hwid:
        if any(k in desc for k in ["display", "vga", "graphics", "geforce", "quadro", "rtx"]):
            matched.add("video")
            vendor_hints["video"] = "nvidia"
        if any(k in desc for k in ["audio", "sound", "hdaudio"]):
            matched.add("sound")
            vendor_hints["sound"] = "nvidia"

    elif "ven_10ec" in hwid:
        if any(k in desc for k in ["ethernet", "network", "lan", "gigabit", "pcie gbe"]):
            matched.add("lan")
            vendor_hints["lan"] = "realtek"
        if any(k in desc for k in ["audio", "sound", "hdaudio"]):
            matched.add("sounds")
            vendor_hints["sounds"] = "realtek"
        if any(k in desc for k in ["wireless", "wifi", "wlan"]):
            matched.add("wlan")
            vendor_hints["wlan"] = "realtek"

    elif "ven_14e4" in hwid:
        if any(k in desc for k in ["ethernet", "network", "lan"]):
            matched.add("lan")
            vendor_hints["lan"] = "broadcom"
        if any(k in desc for k in ["wireless", "wifi", "wlan"]):
            matched.add("wlan")
            vendor_hints["wlan"] = "broadcom"

    # 4. 蓝牙特殊处理
    if "bluetooth" in desc or "bluetooth" in hwid:
        matched.add("wbluetooth")

    # 5. HDAUDIO 设备特殊处理
    if "hdaudio\\func_01&ven_" in hwid:
        matched.add("sounds")
        if "ven_10ec" in hwid:
            vendor_hints["sounds"] = "realtek"
        elif "ven_8086" in hwid:
            vendor_hints["sounds"] = "intel"

    return matched, vendor_hints, ven, dev, subsys

def search_driver_in_7z(archive_path, hardware_ids):
    """
    在 7z 包中搜索匹配硬件ID的驱动文件夹
    一次调用 7z l 获取所有内容，在内存中匹配（避免重复调用）
    """
    matched_folders = set()

    # 提取所有硬件ID中的关键信息
    hw_keywords = set()
    for hw in hardware_ids:
        hw_lower = hw.lower()
        if "dev_" in hw_lower:
            try:
                dev_raw = hw_lower.split("dev_")[1][:4]
                dev_stripped = dev_raw.lstrip("0")
                hw_keywords.add(dev_raw.lower())
                if dev_stripped and dev_stripped != dev_raw.lower():
                    hw_keywords.add(dev_stripped.lower())
                hw_keywords.add(dev_raw.upper())
                if dev_stripped:
                    hw_keywords.add(dev_stripped.upper())
            except:
                pass
        if "ven_" in hw_lower:
            try:
                ven = hw_lower.split("ven_")[1][:4]
                hw_keywords.add(ven.lower())
                hw_keywords.add(ven.upper())
            except:
                pass
        if "subsys_" in hw_lower:
            try:
                subsys = hw_lower.split("subsys_")[1][:8]
                hw_keywords.add(subsys.lower())
                hw_keywords.add(subsys.upper())
            except:
                pass

    target_os = ["10x64", "11x64", "10x86", "11x86", "nt", "win10", "win11"]
    fallback_os = ["7x64", "8x64", "7x86", "8x86"]

    try:
        # 只调用一次 7z l
        result = subprocess.run(
            [SEVEN_ZIP, "l", "-slt", archive_path],
            capture_output=True, text=True, timeout=120, encoding="utf-8", errors="replace"
        )
        if result.returncode != 0:
            return []

        all_paths = []
        for line in result.stdout.split("\n"):
            line = line.strip()
            if line.startswith("Path ="):
                path = line.replace("Path =", "").strip().replace("\\", "/")
                all_paths.append(path)

        # 一次遍历所有路径，分类匹配
        for path in all_paths:
            path_lower = path.lower()
            has_target = any(p in path_lower for p in target_os)
            has_fallback = any(p in path_lower for p in fallback_os)
            has_any_os = any(p in path_lower for p in target_os + fallback_os)

            # 提取文件夹路径
            parts = path.split("/")
            folder = "/".join(parts[:-1]) if "." in parts[-1] else path
            if not folder:
                continue
            folder_lower = folder.lower()

            # 检查是否匹配
            for kw in hw_keywords:
                if kw.lower() in folder_lower:
                    if has_target:
                        matched_folders.add(folder)
                    elif has_fallback:
                        matched_folders.add(folder)
                    elif not has_any_os:
                        matched_folders.add(folder)
                    break  # 匹配到就跳出关键词循环

    except Exception as e:
        print(f"[WARN] 搜索 {archive_path} 失败: {e}")

    return list(matched_folders)

def extract_and_pack(archive_path, folders, output_path):
    """从 7z 中提取指定文件夹路径并重新打包为 zip"""
    tmpdir = tempfile.mkdtemp(prefix="drv_")

    try:
        for folder in folders:
            # 文件夹格式如 "Realtek/FORCED/10x64/D-Link/RTL8168G"
            # 提取整个子目录树
            subprocess.run(
                [SEVEN_ZIP, "x", archive_path, f"-o{tmpdir}", folder, "-r", "-y", "-aoa"],
                capture_output=True, timeout=300
            )

        # 打包成 zip
        if output_path.endswith(".zip"):
            zip_base = output_path[:-4]
        else:
            zip_base = output_path

        if os.path.exists(output_path):
            os.remove(output_path)

        created = shutil.make_archive(zip_base, "zip", tmpdir)
        return os.path.getsize(created) if os.path.exists(created) else 0

    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

# ========== HTTP 服务器 ==========

class RequestHandler(BaseHTTPRequestHandler):

    def log_message(self, format, *args):
        print(f"[{time.strftime('%H:%M:%S')}] {args[0]}")

    def send_cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "*")

    def send_json(self, data, status=200):
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_cors()
        self.end_headers()
        self.wfile.write(json.dumps(data, ensure_ascii=False).encode("utf-8"))

    def serve_static(self, path):
        """提供静态文件"""
        # 安全：防止路径穿越
        safe_path = os.path.normpath(path.lstrip("/"))
        filepath = os.path.join(WEB_DIR, safe_path)

        if not os.path.abspath(filepath).startswith(os.path.abspath(WEB_DIR)):
            self.send_json({"error": "禁止访问"}, 403)
            return

        if not os.path.isfile(filepath):
            self.send_json({"error": "文件不存在"}, 404)
            return

        content_types = {
            ".html": "text/html; charset=utf-8",
            ".css": "text/css; charset=utf-8",
            ".js": "application/javascript; charset=utf-8",
            ".ico": "image/x-icon",
            ".png": "image/png",
            ".jpg": "image/jpeg",
            ".svg": "image/svg+xml",
            ".json": "application/json",
            ".zip": "application/zip",
            ".bat": "application/octet-stream",
            ".ps1": "text/plain; charset=utf-8",
        }
        ext = os.path.splitext(filepath)[1].lower()
        content_type = content_types.get(ext, "application/octet-stream")

        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_cors()
        if ext in [".zip", ".bat"]:
            self.send_header("Content-Disposition", f'attachment; filename="{os.path.basename(filepath)}"')
        self.end_headers()

        with open(filepath, "rb") as f:
            self.wfile.write(f.read())

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_cors()
        self.end_headers()

    def _handle_download_pkg(self, path):
        """处理 /api/download_pkg/ 下载请求"""
        file_param = path.replace("/api/download_pkg/", "")
        file_param = urllib.parse.unquote(file_param)

        # 安全：只允许 Drivers 目录下的 .7z 文件
        file_path = os.path.join(DRIVERS_DIR, file_param)
        if not os.path.abspath(file_path).startswith(os.path.abspath(DRIVERS_DIR)):
            self.send_json({"error": "禁止访问"}, 403)
            return
        if not file_param.endswith(".7z") or not os.path.isfile(file_path):
            self.send_json({"error": "文件不存在"}, 404)
            return

        file_size = os.path.getsize(file_path)
        print(f"[INFO] 下载驱动包: {file_param} ({file_size / 1024 / 1024:.1f} MB)")

        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(file_size))
        self.send_header("Content-Disposition", f'attachment; filename="{file_param}"')
        self.send_cors()
        self.end_headers()

        with open(file_path, "rb") as f:
            while True:
                chunk = f.read(8192)
                if not chunk:
                    break
                self.wfile.write(chunk)

    def _handle_dl_result(self, path):
        """处理 /api/dl_result/ 下载请求"""
        file_param = path.replace("/api/dl_result/", "")
        file_param = urllib.parse.unquote(file_param)

        file_path = os.path.join(tempfile.gettempdir(), file_param)
        if not os.path.isfile(file_path):
            self.send_json({"error": "文件不存在或已过期"}, 404)
            return

        file_size = os.path.getsize(file_path)
        print(f"[INFO] 下载提取包: {file_param} ({file_size / 1024 / 1024:.1f} MB)")

        self.send_response(200)
        self.send_header("Content-Type", "application/zip")
        self.send_header("Content-Length", str(file_size))
        self.send_header("Content-Disposition", f'attachment; filename="{file_param}"')
        self.send_cors()
        self.end_headers()

        with open(file_path, "rb") as f:
            while True:
                chunk = f.read(8192)
                if not chunk:
                    break
                self.wfile.write(chunk)

        try:
            os.remove(file_path)
        except:
            pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        # API 路由
        if path == "/api/drivers":
            drivers = get_driver_list()
            self.send_json({
                "total": len(drivers),
                "total_size_gb": round(sum(d["size_mb"] for d in drivers) / 1024, 1),
                "drivers": drivers
            })
            return

        if path == "/api/client/download":
            # 下载客户端脚本
            self.serve_static("client.bat")
            return

        if path == "/api/test":
            # 测试连接
            self.send_json({"status": "ok", "server": "Driver Install Server v1.0", "time": time.strftime("%Y-%m-%d %H:%M:%S")})
            return

        # 下载路由（GET）
        if path.startswith("/api/download_pkg/"):
            self._handle_download_pkg(path)
            return

        if path.startswith("/api/dl_result/"):
            self._handle_dl_result(path)
            return

        # 静态文件
        if path == "/" or path == "":
            self.serve_static("index.html")
            return

        self.serve_static(path)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path == "/api/analyze":
            # 接收硬件信息，返回匹配的驱动和下载链接
            try:
                length = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(length).decode("utf-8")
                data = json.loads(body)
            except:
                self.send_json({"error": "无效的请求数据"}, 400)
                return

            devices = data.get("devices", [])
            if not devices:
                self.send_json({"error": "未提供设备信息"}, 400)
                return

            print(f"[INFO] 收到 {len(devices)} 个设备信息，正在分析...")

            # 为每个设备匹配驱动包
            all_matched_drivers = {}  # {cat: {"devices": [...], "vendor_hint": "xxx"}}
            unmatched_devices = []

            for device in devices:
                hwid = device.get("hwid", "")
                desc = device.get("description", "")
                matched_cats, vendor_hints, ven, dev, subsys = match_drivers_for_device(desc, hwid)

                if matched_cats:
                    for cat in matched_cats:
                        if cat not in all_matched_drivers:
                            all_matched_drivers[cat] = {"devices": [], "vendor_hint": None}
                        all_matched_drivers[cat]["devices"].append({
                            "hwid": hwid,
                            "description": desc
                        })
                        if cat in vendor_hints:
                            all_matched_drivers[cat]["vendor_hint"] = vendor_hints[cat]
                else:
                    unmatched_devices.append({"hwid": hwid, "description": desc})

            # 构建驱动下载列表 - 根据厂商提示精确过滤
            all_drivers = get_driver_list()
            driver_results = []

            for drv in all_drivers:
                drv_name_lower = drv["name"].lower()
                parts = drv_name_lower.split("_")
                drv_cat = parts[1] if len(parts) > 1 else ""

                if drv_cat not in all_matched_drivers:
                    continue

                # 厂商精确过滤
                vendor_hint = all_matched_drivers[drv_cat].get("vendor_hint")
                if vendor_hint:
                    # 驱动包名必须包含厂商名才匹配
                    if vendor_hint not in drv_name_lower:
                        continue

                # 过滤掉 XP/Server 版本（用户大概率是 Win10/11）
                if "-xp_" in drv_name_lower or "_xp" in drv_name_lower:
                    continue
                if "server_" in drv_name_lower and "nt" not in drv_name_lower:
                    continue

                driver_results.append({
                    "file": drv["file"],
                    "name": drv["name"],
                    "size_mb": drv["size_mb"],
                    "category": drv_cat,
                    "matched_devices": all_matched_drivers[drv_cat]["devices"],
                    "download_url": f"/api/download_pkg/{urllib.parse.quote(drv['file'])}"
                })

            # 按大小排序
            driver_results.sort(key=lambda x: x["size_mb"])

            result = {
                "success": True,
                "total_devices": len(devices),
                "matched_categories": len(all_matched_drivers),
                "matched_drivers": len(driver_results),
                "total_size_mb": round(sum(d["size_mb"] for d in driver_results), 1),
                "drivers": driver_results,
                "unmatched": unmatched_devices
            }

            print(f"[INFO] 匹配完成: {len(driver_results)} 个驱动包, {result['total_size_mb']} MB")
            self.send_json(result)
            return

        if path == "/api/search_and_pack":
            # 精确搜索：在驱动包中查找匹配硬件ID的文件夹，只提取需要的部分
            try:
                length = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(length).decode("utf-8")
                data = json.loads(body)
            except:
                self.send_json({"error": "无效的请求数据"}, 400)
                return

            devices = data.get("devices", [])
            selected_drivers = data.get("drivers", [])  # 用户选择的驱动包

            if not devices or not selected_drivers:
                self.send_json({"error": "参数不完整"}, 400)
                return

            print(f"[INFO] 精确搜索驱动: {len(selected_drivers)} 个包, {len(devices)} 个设备...")

            # 收集所有硬件ID
            all_hwids = [d.get("hwid", "") for d in devices]

            # === 优先使用 JSON 索引（毫秒级） ===
            index_result = fast_search_by_index(all_hwids, selected_drivers)
            
            if index_result is not None:
                # 使用索引结果构建响应
                results = []
                total_extracted = 0
                for pkg in index_result:
                    results.append({
                        "original": pkg["file"],
                        "matched_hwids": pkg.get("matched_hwids", []),
                        "matched_count": pkg.get("matched_count", 0),
                        "extracted_size_mb": pkg["size_mb"],
                        "download_url": pkg["download_url"],
                        "full_package": True,
                        "method": "index"
                    })
                    total_extracted += pkg["size_mb"] * 1024 * 1024
                
                result = {
                    "success": True,
                    "results": results,
                    "total_size_mb": round(total_extracted / 1024 / 1024, 1),
                    "message": f"找到 {len(results)} 个匹配包 (索引)",
                    "method": "index"
                }
                
                print(f"[INFO] 索引搜索完成: {result['total_size_mb']} MB ({len(results)} 包)")
                self.send_json(result)
                return
            
            # === 回退到 7z 实时扫描 ===
            results = []
            total_extracted = 0

            for drv_file in selected_drivers:
                archive_path = os.path.join(DRIVERS_DIR, drv_file)
                if not os.path.exists(archive_path):
                    continue

                # 在 7z 包中搜索匹配的文件夹
                folders = search_driver_in_7z(archive_path, all_hwids)

                if folders:
                    # 创建精确提取包
                    output_name = drv_file.replace(".7z", "_matched.zip")
                    output_path = os.path.join(tempfile.gettempdir(), output_name)

                    size = extract_and_pack(archive_path, folders, output_path)

                    if size > 0:
                        results.append({
                            "original": drv_file,
                            "matched_folders": len(folders),
                            "folders": folders[:10],
                            "extracted_size_mb": round(size / 1024 / 1024, 1),
                            "download_url": f"/api/dl_result/{urllib.parse.quote(output_name)}",
                            "output_file": output_path,
                            "output_name": output_name
                        })
                        total_extracted += size
                else:
                    # 没有精确匹配到子文件夹，使用整个包
                    results.append({
                        "original": drv_file,
                        "matched_folders": 0,
                        "folders": [],
                        "extracted_size_mb": round(os.path.getsize(archive_path) / 1024 / 1024, 1),
                        "download_url": f"/api/download_pkg/{urllib.parse.quote(drv_file)}",
                        "full_package": True
                    })
                    total_extracted += os.path.getsize(archive_path)

            result = {
                "success": True,
                "results": results,
                "total_size_mb": round(total_extracted / 1024 / 1024, 1),
                "message": f"找到 {sum(1 for r in results if r.get('matched_folders', 0) > 0)} 个精确匹配包"
            }

            print(f"[INFO] 精确搜索完成: {result['total_size_mb']} MB")
            self.send_json(result)
            return

        if path.startswith("/api/download_pkg/"):
            self._handle_download_pkg(path)
            return

        if path.startswith("/api/dl_result/"):
            self._handle_dl_result(path)
            return

        self.send_json({"error": "未知接口"}, 404)


def main():
    print("=" * 60)
    print("  在线驱动安装服务 v1.0")
    print("  Driver Install Server")
    print("=" * 60)
    print(f"  驱动目录: {DRIVERS_DIR}")
    print(f"  静态文件: {WEB_DIR}")
    print(f"  监听端口: {PORT}")
    print(f"  7-Zip: {SEVEN_ZIP}")

    drivers = get_driver_list()
    total_gb = sum(d["size_mb"] for d in drivers) / 1024
    print(f"  驱动包: {len(drivers)} 个 ({total_gb:.1f} GB)")
    print("=" * 60)

    # 检查 7-Zip
    if not os.path.exists(SEVEN_ZIP):
        print("[ERROR] 7-Zip 未找到，请安装: https://www.7-zip.org/")
        sys.exit(1)

    server = HTTPServer((HOST, PORT), RequestHandler)
    print(f"\n[INFO] 服务器启动: http://{HOST}:{PORT}")
    print("[INFO] 通过 Cloudflare Tunnel 访问: https://yanhong.online")
    print("[INFO] 按 Ctrl+C 停止服务器\n")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[INFO] 服务器已停止")
        server.shutdown()


if __name__ == "__main__":
    main()
